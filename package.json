{
  "name": "@thecuvii/solaris",
  "version": "0.0.0",
  "description": "React shader effects for the solar system.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./earth": {
      "types": "./dist/earth/index.d.mts",
      "import": "./dist/earth/index.mjs"
    },
    "./jupiter": {
      "types": "./dist/jupiter/index.d.mts",
      "import": "./dist/jupiter/index.mjs"
    },
    "./mars": {
      "types": "./dist/mars/index.d.mts",
      "import": "./dist/mars/index.mjs"
    },
    "./mercury": {
      "types": "./dist/mercury/index.d.mts",
      "import": "./dist/mercury/index.mjs"
    },
    "./moon": {
      "types": "./dist/moon/index.d.mts",
      "import": "./dist/moon/index.mjs"
    },
    "./neptune": {
      "types": "./dist/neptune/index.d.mts",
      "import": "./dist/neptune/index.mjs"
    },
    "./observed-sun": {
      "types": "./dist/observed-sun/index.d.mts",
      "import": "./dist/observed-sun/index.mjs"
    },
    "./pluto": {
      "types": "./dist/pluto/index.d.mts",
      "import": "./dist/pluto/index.mjs"
    },
    "./saturn": {
      "types": "./dist/saturn/index.d.mts",
      "import": "./dist/saturn/index.mjs"
    },
    "./sun": {
      "types": "./dist/sun/index.d.mts",
      "import": "./dist/sun/index.mjs"
    },
    "./titan": {
      "types": "./dist/titan/index.d.mts",
      "import": "./dist/titan/index.mjs"
    },
    "./uranus": {
      "types": "./dist/uranus/index.d.mts",
      "import": "./dist/uranus/index.mjs"
    },
    "./venus": {
      "types": "./dist/venus/index.d.mts",
      "import": "./dist/venus/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "build:website": "pnpm --filter website build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "dev": "pnpm --filter website dev",
    "prepare": "vp config --no-agent",
    "size": "vp pack && node scripts/check-bundle-size.mjs",
    "test": "vp test --run"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plus": "0.3.0"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.0.0"
}
